---
/**
 * ImageGrid component
 *
 * Displays a set of photos in a centred grid. Each image is placed in a
 * 500px square cell so portrait and landscape orientations line up neatly.
 * The grid starts as a single column and expands to two columns at 1500px
 * and three columns above 2000px.
 *
 * Props:
 *   images – array of image URLs to display
 *   alt?   – optional alt text for each image (same order as `images`)
 */
export interface Props {
  images: string[];
  alt?: string[];
}
const { images, alt = [] } = Astro.props;
---
<div class="image-grid">
  {images.map((src, i) => (
    <!-- Wrap each image in a fixed-size cell so they align evenly -->
    <div class="image-cell" aria-label={alt[i] ?? ''}>
      <img src={src} alt={alt[i] ?? ''} />
    </div>
  ))}
</div>

<style>
  /* Grid container: centred with a single 500px column by default */
  .image-grid {
    display: grid;
    gap: 0.5rem;
    justify-content: center;
    margin: 0 auto;
    padding: 5px 0;
    grid-template-columns: 500px;
  }

  /* Expand to two columns on wider screens */
  @media (min-width: 1500px) {
    .image-grid {
      grid-template-columns: repeat(2, 500px);
    }
  }

  /* Three columns for very large screens */
  @media (min-width: 2000px) {
    .image-grid {
      grid-template-columns: repeat(3, 500px);
    }
  }

  /* Individual cell: fixed-size square crop */
  .image-cell {
    width: 500px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  /* Scale images to fill the cell while preserving aspect ratio */
  .image-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* On small devices let images shrink to the container width */
  @media (max-width: 800px) {
    .image-cell {
      width: 100%;
    }
    .image-grid {
      grid-template-columns: 1fr;
    }
  }
</style>